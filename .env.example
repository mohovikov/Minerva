# Режим отладки (True для разработки, False для продакшена)
DEBUG=True

# Секретный ключ (обязательно сгенерируйте свой для продакшена!)
# Можно сгенерировать командой: python -c "import secrets; print(secrets.token_hex(32)) или openssl rand -hex 32"
SECRET_KEY=ev

# Разрешенные хосты (через запятую, без пробелов)
ALLOWED_HOSTS=127.0.0.1,localhost

# IP для Django Debug Toolbar (работает только при DEBUG=True (через запятую, без пробелов))
INTERNAL_IPS=127.0.0.1

# Папка для базы данных и загруженных артов
# Если оставить пустым, будет использоваться папка .data в корне проекта.
DATA_DIR=

# Язык интерфейса (код языка по стандарту ISO 639-1).
LANGUAGE_CODE=ru-ru

# Часовой пояс (база данных IANA Time Zone).
# Используется для отображения времени в шаблонах и админке.
TIME_ZONE=Europe/Moscow